<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests against a real Empower database, configured in the repository's git-ignored .env (see .env.example).
    Not in Empower2Asm.Core.slnf nor CI: it needs the Empower Toolkit and a database. Unconfigured, its tests are skipped,
    except the adapter's own tests (Adapter/), which need only the Toolkit to build.
  -->
  <PropertyGroup>
    <RootNamespace>Empower2Asm.IntegrationTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <EmpowerToolkitInteropDir Condition="'$(EmpowerToolkitInteropDir)' == ''">$(EMPOWER_TOOLKIT_INTEROP_DIR)</EmpowerToolkitInteropDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Empower2Asm.Core\Empower2Asm.Core.csproj" />
    <ProjectReference Include="..\..\src\Empower2Asm.Empower\Empower2Asm.Empower.csproj" />
    <!-- Built first, then run as a process from its own output folder, as a scheduled task would. -->
    <ProjectReference Include="..\..\src\Empower2Asm.Cli\Empower2Asm.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Finds the IDs a selection test needs (an Injection's Sample Set, its Results' Result Set) without reading raw
         data. Embedded like the adapter's, so no Waters assembly is copied to the output. -->
    <Reference Include="Interop.MillenniumToolkit">
      <HintPath>$([MSBuild]::EnsureTrailingSlash('$(EmpowerToolkitInteropDir)'))Interop.MillenniumToolkit.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Empower2Asm.Core.Tests\Mapping\AsmSchema.cs" Link="AsmSchema.cs" />
    <None Include="..\Empower2Asm.Core.Tests\Fixtures\schemas\*.json" Link="Fixtures\schemas\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Cli</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src\Empower2Asm.Cli\bin\$(Configuration)\$(TargetFramework)\empower2asm.exe'))</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepositoryRoot</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
