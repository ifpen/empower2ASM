<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mapping from Empower data to ASM. Must never reference the Empower Toolkit. -->
  <PropertyGroup>
    <RootNamespace>Empower2Asm.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="IFPEN.AllotropeConverters.AllotropeModels.Hplc" />
    <!-- The tz database's zone abbreviations (CET, CEST…), which give the UTC offset of a date-time from Empower. -->
    <PackageReference Include="NodaTime" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>
</Project>
