# Settings for tests/Empower2Asm.IntegrationTests. Copy to .env (git-ignored) and fill in.
# Without EMPOWER_IT_USER, EMPOWER_IT_PROJECT, EMPOWER_IT_FROM, EMPOWER_IT_TO, EMPOWER_IT_ELSD_PROJECT and
# EMPOWER_IT_ELSD_INJECTION, the Empower tests are skipped.
# A variable set in the environment overrides this file.

# Empower database (Oracle service); empty for the local service.
EMPOWER_IT_DATABASE=
# A read-only Empower user, and its password (empty if it has none).
EMPOWER_IT_USER=
EMPOWER_IT_PASSWORD=
# A Project that user can read (a sub-Project as Parent\Child), and a short Acquisition Window in it whose
# Injections all convert, as for export's --from/--to (e.g. 2026-03-02T08:00 and 2026-03-02T09:00). Each Injection
# can take a minute or more to read: keep it to a few Injections.
EMPOWER_IT_PROJECT=
EMPOWER_IT_FROM=
EMPOWER_IT_TO=
# An Injection with an ELSD Channel (signal in LSU) that has a Result with found Peaks (not only Missing ones), and its
# Project: ELSD data is always tested, whatever the window above holds.
EMPOWER_IT_ELSD_PROJECT=
EMPOWER_IT_ELSD_INJECTION=
